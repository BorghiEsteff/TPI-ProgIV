PORT=5000
NODE_ENV=development

# Base de datos MongoDB
MONGODB_URI=mongodb://localhost:27017/cinetrack_social

# Clave compartida para JWT (debe coincidir exactamente con Django)
JWT_SIGNING_KEY=super-secret-jwt-signing-key-shared-between-services

# Integración con Backend Django
DJANGO_API_URL=http://localhost:8000/api/v1
DJANGO_TIMEOUT_MS=2500

# Integración con Microservicio IA
AI_SERVICE_URL=http://localhost:8002/ai
AI_TIMEOUT_MS=4000

# CORS
CLIENT_ORIGIN=http://localhost:5173
