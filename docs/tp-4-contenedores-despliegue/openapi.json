{
  "openapi": "3.0.3",
  "info": {
    "title": "CineTrack Node.js Backend API",
    "version": "2.0.0",
    "description": "API REST y GraphQL de notas personales privadas (MongoDB) y proxy de recomendaciones IA (FastAPI/Groq). Los endpoints heredados de reseñas públicas responden 410 Gone."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Servidor local Node.js"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health-check del servicio Node.js",
        "responses": {
          "200": {
            "description": "Servicio operativo"
          }
        }
      }
    },
    "/api/v1/personal-notes": {
      "get": {
        "summary": "Obtener notas personales por lote (filtradas por owner)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "trackingEntryIds",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Lista separada por comas de IDs de UserProgress"
          }
        ],
        "responses": {
          "200": { "description": "Notas privadas del usuario autenticado" },
          "401": { "description": "Token ausente o inválido" }
        }
      }
    },
    "/api/v1/personal-notes/{trackingEntryId}": {
      "get": {
        "summary": "Obtener nota personal de una entrada del diario",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "trackingEntryId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Nota encontrada" },
          "401": { "description": "No autenticado" },
          "403": { "description": "No es propietario de la entrada" },
          "404": { "description": "Nota no encontrada" }
        }
      },
      "put": {
        "summary": "Crear o actualizar nota personal privada (rating 1..5 y comentario)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "trackingEntryId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "notes": { "type": "string", "maxLength": 2000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Nota guardada" },
          "400": { "description": "Validación fallida" },
          "401": { "description": "No autenticado" },
          "403": { "description": "No es propietario" }
        }
      },
      "delete": {
        "summary": "Eliminar nota personal privada",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "trackingEntryId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Nota eliminada" },
          "401": { "description": "No autenticado" },
          "403": { "description": "No es propietario" },
          "404": { "description": "No encontrada" }
        }
      }
    },
    "/api/v1/recommendations": {
      "post": {
        "summary": "Solicitar recomendaciones IA acotadas al catálogo publicado",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "prompt": { "type": "string", "maxLength": 500 },
                  "history": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": { "type": "string", "enum": ["user", "assistant"] },
                        "content": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Recomendaciones filtradas y bandera degraded" },
          "401": { "description": "No autenticado" },
          "422": { "description": "Prompt inválido o fuera de límites" },
          "429": { "description": "Rate limit por usuario excedido" }
        }
      }
    },
    "/api/v1/reviews": {
      "get": {
        "summary": "Endpoint heredado retirado",
        "responses": { "410": { "description": "Reseñas públicas retiradas (Gone)" } }
      },
      "post": {
        "summary": "Endpoint heredado retirado",
        "responses": { "410": { "description": "Reseñas públicas retiradas (Gone)" } }
      }
    },
    "/graphql": {
      "post": {
        "summary": "Endpoint GraphQL (consulta publicMediaDetails)",
        "responses": {
          "200": { "description": "Respuesta GraphQL" }
        }
      }
    }
  }
}
