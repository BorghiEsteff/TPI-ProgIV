# Modo local directo (por defecto para abrir http://localhost:5173):
VITE_DJANGO_API_URL=http://localhost:8000/api/v1
VITE_DJANGO_GRAPHQL_URL=http://localhost:8000/graphql/
VITE_NODE_API_URL=http://localhost:5000/api/v1
VITE_NODE_GRAPHQL_URL=http://localhost:5000/graphql
VITE_NODE_SOCKET_URL=

# Modo proxy único / Tailscale Serve (ejecutar `node proxy/local-proxy.mjs` y abrir http://localhost:8088):
# VITE_DJANGO_API_URL=/django/api/v1
# VITE_DJANGO_GRAPHQL_URL=/django/graphql/
# VITE_NODE_API_URL=/node/api/v1
# VITE_NODE_GRAPHQL_URL=/node/graphql
# VITE_NODE_SOCKET_URL=
