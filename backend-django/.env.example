# Configuración Django
SECRET_KEY=django-insecure-change-this-in-production-demo-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL
DB_NAME=cinetrack_db
DB_USER=cinetrack_user
DB_PASSWORD=cinetrack_pass
DB_HOST=localhost
DB_PORT=5432

# Clave compartida para JWT (debe ser IDÉNTICA a la de Node)
JWT_SIGNING_KEY=super-secret-jwt-signing-key-shared-between-services

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
