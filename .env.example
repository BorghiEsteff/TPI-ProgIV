# ============================================================================
# CineTracker / CineTrack - Variables de entorno para Docker Compose (raíz)
# Copiar a .env antes de ejecutar: docker compose up --build
# ============================================================================

# PostgreSQL 16
DB_NAME=cinetrack_db
DB_USER=cinetrack_user
DB_PASSWORD=replace-with-strong-db-password

# MongoDB 7
MONGO_DB=cinetrack_social

# Django
SECRET_KEY=replace-with-strong-django-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,django-backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secreto JWT compartido entre Django (emisor) y Node.js (verificador)
JWT_SIGNING_KEY=replace-with-shared-jwt-signing-key-min-32-chars

# Node.js CORS
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Servicio IA (FastAPI + Groq Cloud; vacio activa fallback determinista)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Frontend (URLs visibles desde el navegador del cliente)
VITE_DJANGO_API_URL=http://localhost:8000/api/v1
VITE_DJANGO_GRAPHQL_URL=http://localhost:8000/graphql/
VITE_NODE_API_URL=http://localhost:5000/api/v1
VITE_NODE_GRAPHQL_URL=http://localhost:5000/graphql
VITE_NODE_SOCKET_URL=http://localhost:5000
