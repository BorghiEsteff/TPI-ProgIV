# ============================================================================
# CineTracker / CineTrack - Variables de entorno para Docker Compose (raíz)
# Copiar a .env antes de ejecutar: docker compose up --build
# ============================================================================

# PostgreSQL 16 (red interna Docker)
DB_NAME=cinetrack_db
DB_USER=cinetrack_user
DB_PASSWORD=replace-with-strong-db-password

# MongoDB 7 (red interna Docker)
MONGO_DB=cinetrack_social

# Django (en Tailscale agregar el hostname real de la tailnet, nunca '*')
SECRET_KEY=replace-with-strong-django-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,django-backend
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
SERVE_MEDIA=True

# Secreto JWT compartido entre Django (emisor) y Node.js (verificador)
JWT_SIGNING_KEY=replace-with-shared-jwt-signing-key-min-32-chars

# Node.js CORS (en Tailscale incluir https://<equipo>.<tailnet>.ts.net)
CLIENT_ORIGIN=http://127.0.0.1:8088,http://localhost:8088

# Servicio IA (FastAPI + Groq Cloud; vacio activa fallback determinista)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Proxy local único (loopback; expuesto de forma privada vía Tailscale Serve)
PROXY_PORT=8088

# Frontend (URLs relativas del mismo origen para proxy único / Tailscale Serve)
VITE_DJANGO_API_URL=/django/api/v1
VITE_DJANGO_GRAPHQL_URL=/django/graphql/
VITE_NODE_API_URL=/node/api/v1
VITE_NODE_GRAPHQL_URL=/node/graphql
VITE_NODE_SOCKET_URL=
